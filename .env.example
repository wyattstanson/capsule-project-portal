# ─── Capsule Portal environment ─────────────────────────────────────────────
# Copy to .env and adjust. Never commit the real .env.

NODE_ENV=development
API_PORT=4000

# ─── Database ───────────────────────────────────────────────────────────────
# The API talks to pgbouncer, NOT postgres directly.
# pgbouncer pools connections so 5k concurrent clients map to a small pool.
# Host ports are 55432 (postgres) / 56432 (pgbouncer) to avoid colliding with a
# native Postgres already on 5432/6432. Inside docker-compose the services use
# their standard ports (postgres:5432, pgbouncer:6432) via the service network.
DATABASE_URL=postgres://capsule:capsule@localhost:56432/capsule
# Direct URL (bypasses pgbouncer) — used only by the migration runner,
# because DDL + advisory locks need a real session, not a pooled one.
DATABASE_DIRECT_URL=postgres://capsule:capsule@localhost:55432/capsule
PG_POOL_MAX=20

# ─── Redis ──────────────────────────────────────────────────────────────────
# Host port 56379 to avoid colliding with a native Redis on 6379.
REDIS_URL=redis://localhost:56379

# ─── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=dev-only-change-me-in-production
JWT_EXPIRES_IN=12h
# In dev the OTP is returned in the API response and logged. In prod it is
# dispatched via the notification queue (email/SMS) and never returned.
OTP_TTL_SECONDS=300

# ─── Rate limiting ──────────────────────────────────────────────────────────
# Max team-requests a student may send per window.
RATE_REQUESTS_PER_MIN=10

# ─── External student-portal sync ───────────────────────────────────────────
# Leave blank to run in export-only mode (writes a sync payload to the audit
# log + a local file). Set to a URL to POST approved project IDs as a webhook.
EXTERNAL_PORTAL_WEBHOOK_URL=
EXTERNAL_PORTAL_WEBHOOK_SECRET=

# ─── Uploads ────────────────────────────────────────────────────────────────
# Proof-of-placement files (CDC route). Local disk in dev; swap for S3 in prod.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ─── Frontend ───────────────────────────────────────────────────────────────
WEB_ORIGIN=http://localhost:5173
