{
  "name": "capsule-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Capsule Project Team-Formation & Approval Portal",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "infra:up": "docker compose up -d postgres pgbouncer redis",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "db:migrate": "npm --workspace server run migrate",
    "db:seed": "npm --workspace server run seed",
    "dev:server": "npm --workspace server run dev",
    "dev:worker": "npm --workspace server run dev:worker",
    "dev:web": "npm --workspace web run dev",
    "build": "npm --workspace server run build && npm --workspace web run build",
    "loadtest": "k6 run load-test/k6-script.js"
  },
  "engines": {
    "node": ">=20"
  }
}
